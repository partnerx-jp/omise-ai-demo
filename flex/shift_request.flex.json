{
  "type": "flex",
  "altText": "📝 シフト希望の提出をお願いします（対象 {{shift_period}}・締切 {{shift_deadline}}）。タップで入力",
  "contents": {
    "type": "bubble",
    "size": "kilo",
    "header": {
      "type": "box", "layout": "vertical", "paddingAll": "16px", "backgroundColor": "#FFFFFF", "spacing": "none",
      "contents": [
        { "type": "text", "text": "{{date_ja}}", "size": "xxs", "color": "#ABABAB" },
        { "type": "text", "text": "📝 シフト希望の提出をお願いします", "size": "md", "weight": "bold", "color": "#1A1A1A", "margin": "sm", "wrap": true },
        { "type": "text", "text": "梅田店 スタッフのみなさんへ", "size": "xxs", "color": "#888888", "margin": "sm" },
        { "type": "separator", "margin": "md", "color": "#E7E7E7" }
      ]
    },
    "body": {
      "type": "box", "layout": "vertical", "paddingAll": "16px", "spacing": "sm",
      "contents": [
        { "type": "box", "layout": "horizontal", "contents": [
          { "type": "text", "text": "対象期間", "size": "sm", "color": "#888888", "flex": 3 },
          { "type": "text", "text": "{{shift_period}}", "size": "sm", "weight": "bold", "color": "#333333", "align": "end", "flex": 7 } ] },
        { "type": "box", "layout": "horizontal", "contents": [
          { "type": "text", "text": "提出締切", "size": "sm", "color": "#888888", "flex": 3 },
          { "type": "text", "text": "{{shift_deadline}}", "size": "sm", "weight": "bold", "color": "#E5504F", "align": "end", "flex": 7 } ] },
        { "type": "box", "layout": "vertical", "margin": "md", "paddingAll": "12px", "backgroundColor": "#F5F7F8", "cornerRadius": "8px",
          "contents": [
            { "type": "text", "text": "下のボタンから、勤務できる日と希望の時間帯（早番／中番／遅番）を選んで提出してください。未提出の方には締切前日にAIが自動でお声がけします。", "size": "xs", "color": "#555555", "wrap": true }
          ] }
      ]
    },
    "footer": {
      "type": "box", "layout": "vertical", "paddingAll": "12px",
      "contents": [
        { "type": "button", "style": "primary", "color": "#06C755", "height": "sm",
          "action": { "type": "uri", "label": "シフト希望を入力する", "uri": "{{liff_shift_request_url}}" } }
      ]
    }
  }
}
